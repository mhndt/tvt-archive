# Select one Compose setup. Use : between files on Linux/macOS.
COMPOSE_FILE=compose/compose.yaml
# Intel/AMD example:
# COMPOSE_FILE=compose/compose.yaml:compose/intel-amd.yaml
# NVIDIA example:
# COMPOSE_FILE=compose/compose.yaml:compose/nvidia.yaml

TVT_ARCHIVE_HOST=0.0.0.0
TVT_ARCHIVE_PORT=8099
TVT_ARCHIVE_IMAGE=ghcr.io/mhndt/tvt-archive:0.8.4
# Optional: used only when the bridge creates a fresh config volume.
TVT_ARCHIVE_TOKEN=
TVT_ARCHIVE_ACCELERATOR=auto
TVT_ARCHIVE_DRI_DEVICE=/dev/dri/renderD128
TVT_ARCHIVE_VAAPI_DRIVER=auto
TVT_ARCHIVE_STREAM_AUDIO_DELAY_MS=0

# Intel/AMD only: replace these with the group IDs from your Docker host.
TVT_ARCHIVE_RENDER_GID=109
TVT_ARCHIVE_VIDEO_GID=44
